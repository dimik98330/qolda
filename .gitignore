!models/e02-a/A-tcn.safetensors
*.onnx
*.tflite
*.f32
*.pt
*.pth

# Videos, datasets and local caches: participant data never enters Git.
*.mp4
!docs/media/*.mp4
*.mov
*.avi
*.webm
*.zip
*.crdownload
*.npz
*.npy
*.pkl
*.pickle
raw-data/
pose-cache/
local-data/
ml/runs/
ml/manifest.json
.seriq-local/

